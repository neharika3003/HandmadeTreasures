<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Seller Orders - Handmade Treasures</title>
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    :root {
      --ink: #34496e;
      --ink-soft: #7895b2;
      --body-text: #2d3436;
      --surface: #ffffff;
      --surface-soft: #f3f4f7;
      --surface-blue: #eef5fb;
      --accent: #3aa8c1;
      --line: rgba(52, 73, 110, 0.12);
      --shadow: 0 12px 28px rgba(0, 0, 0, 0.1);
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      margin: 0;
      color: var(--body-text);
    }

    .orders-nav-wrap {
      padding: 0;
    }

    .orders-nav {
      width: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      background: var(--surface);
      border: 1px solid rgba(52, 73, 110, 0.08);
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
      position: relative;
    }

    .orders-brand {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      color: var(--ink);
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    .orders-menu-toggle {
      display: none;
      background: #34496e;
      color: #fff;
      padding: 10px 14px;
      border-radius: 10px;
      font-size: 20px;
      line-height: 1;
      border: none;
      cursor: pointer;
    }

    .orders-menu-toggle:hover,
    .orders-menu-toggle:focus {
      background: #3aa8c1;
      box-shadow: none;
      transform: none;
    }

    .orders-nav-links {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .orders-nav-links a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 40px;
      padding: 0 16px;
      border-radius: 999px;
      color: var(--ink);
      font-size: 0.95rem;
      font-weight: 600;
      transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
    }

    .orders-nav-links a:hover {
      background: rgba(52, 73, 110, 0.08);
      transform: translateY(-1px);
      color: var(--ink);
    }

    @media (max-width: 900px) {
      .orders-nav {
        padding: 12px 20px;
      }

      .orders-brand {
        font-size: 1.15rem;
      }

      .orders-nav-links {
        gap: 8px;
      }

      .orders-nav-links a {
        font-size: 0.88rem;
        padding: 0 14px;
      }
    }

    .orders-shell {
      max-width: 1200px;
      margin: 0 auto;
      padding: 18px 20px 56px;
    }

    .orders-hero {
      margin-top: 12px;
      padding: 22px 24px;
      border: 1px solid rgba(52, 73, 110, 0.08);
      border-radius: 20px;
      background: linear-gradient(135deg, var(--surface-blue), var(--surface));
      box-shadow: var(--shadow);
    }

    .orders-hero h1 {
      margin: 0 0 8px;
      text-align: left;
      font-size: clamp(1.7rem, 3.2vw, 2.6rem);
      line-height: 1.15;
      color: var(--ink-soft);
    }

    .hero-copy {
      max-width: 700px;
      margin: 0;
      font-size: 0.96rem;
      line-height: 1.55;
      color: var(--body-text);
    }

    .hero-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
      margin-top: 18px;
    }

    .stat-card {
      padding: 12px 14px;
      border: 1px solid rgba(52, 73, 110, 0.08);
      border-radius: 14px;
      background: var(--surface);
    }

    .stat-label {
      margin: 0 0 4px;
      font-size: 0.8rem;
      color: var(--ink-soft);
    }

    .stat-value {
      margin: 0;
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--ink);
    }

    .orders-grid {
      display: grid;
      gap: 16px;
      margin-top: 18px;
    }

    .order-card {
      overflow: hidden;
      border: 1px solid rgba(52, 73, 110, 0.08);
      border-radius: 16px;
      background: var(--surface);
      box-shadow: var(--shadow);
    }

    .order-card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 16px 18px 14px;
      background: var(--surface-blue);
      border-bottom: 1px solid var(--line);
    }

    .order-label {
      margin: 0 0 6px;
      font-size: 0.76rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-soft);
    }

    .order-id {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      font-size: 1rem;
      font-weight: 700;
      color: var(--ink);
      word-break: break-word;
    }

    .order-id-text {
      word-break: break-word;
    }

    .order-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .meta-chip {
      display: inline-flex;
      align-items: center;
      padding: 7px 12px;
      border-radius: 999px;
      background: var(--surface);
      color: var(--ink);
      font-size: 0.85rem;
      font-weight: 600;
    }

    .status-pill {
      align-self: center;
      padding: 8px 13px;
      border-radius: 999px;
      font-size: 0.84rem;
      font-weight: 700;
      text-transform: capitalize;
      white-space: nowrap;
    }

    .status-placed {
      background: #eef5fb;
      color: var(--ink);
    }

    .status-pending {
      background: #eef5fb;
      color: var(--ink);
    }

    .status-shipped {
      background: #e0f4f7;
      color: #245f92;
    }

    .status-delivered {
      background: #e7f4ec;
      color: #2d6b57;
    }

    .status-cancelled {
      background: #f1f3f6;
      color: var(--ink-soft);
    }

    .status-default {
      background: #eef1f5;
      color: var(--ink);
    }

    .order-body {
      padding: 16px 18px;
    }

    .order-overview {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(220px, 1fr);
      gap: 16px;
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .product-tile,
    .buyer-card {
      border: 1px solid rgba(52, 73, 110, 0.08);
      border-radius: 12px;
      background: var(--surface-soft);
    }

    .product-tile {
      display: flex;
      gap: 12px;
      align-items: center;
      padding: 10px 12px;
    }

    .product-thumb {
      width: 62px;
      height: 62px;
      flex-shrink: 0;
      border-radius: 10px;
      object-fit: cover;
      box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
      background: #f0f0f0;
    }

    .product-copy {
      min-width: 0;
    }

    .product-title {
      margin: 0 0 4px;
      font-size: 0.95rem;
      color: var(--ink);
      text-align: left;
    }

    .product-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
    }

    .product-copy p,
    .buyer-card p {
      margin: 0;
      color: var(--body-text);
      line-height: 1.4;
      font-size: 0.9rem;
    }

    .buyer-card {
      padding: 12px 14px;
    }

    .buyer-card h3 {
      margin: 0 0 8px;
      text-align: left;
      font-size: 0.9rem;
      color: var(--ink);
    }

    .buyer-card {
      display: grid;
      gap: 8px;
      align-content: start;
    }

    .order-footer {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px solid var(--line);
    }

    .action-buttons {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items: center;
    }

    .seller-actions,
    .seller-actions form {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items: center;
      margin: 0;
    }

    .action-btn,
    .seller-actions select {
      min-height: 36px;
      border-radius: 5px;
      font-size: 0.85rem;
    }

    .action-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 12px;
      border: none;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
    }

    .action-btn-primary {
      background: var(--ink);
      color: #fff;
    }

    .action-btn-primary:hover {
      background: var(--accent);
      color: #fff;
    }

    .seller-actions select {
      padding: 0 10px;
      border: 1px solid rgba(52, 73, 110, 0.16);
      background: #fff;
      color: var(--body-text);
    }

    .seller-actions button {
      min-height: 36px;
      padding: 0 12px;
      border: none;
      border-radius: 5px;
      font-size: 0.85rem;
      font-weight: 700;
      background: #4CAF50;
      color: #fff;
      cursor: pointer;
    }

    .seller-actions button:hover {
      background: #45a049;
    }

    .empty-state {
      margin-top: 18px;
      padding: 34px 20px;
      text-align: center;
      border-radius: 16px;
      border: 1px solid rgba(52, 73, 110, 0.08);
      background: var(--surface);
      box-shadow: var(--shadow);
    }

    .empty-state h2 {
      margin: 0 0 12px;
      color: var(--ink-soft);
    }

    .empty-state p {
      margin: 0;
      color: var(--body-text);
      line-height: 1.6;
    }

    @media (max-width: 768px) {
      .orders-nav-wrap {
        padding: 14px 14px 0;
      }

      .orders-nav {
        padding: 14px 18px;
        align-items: center;
        flex-wrap: wrap;
      }

      .orders-brand {
        z-index: 2;
      }

      .orders-menu-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .orders-nav-links {
        display: none;
        width: 100%;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 14px;
        padding-top: 14px;
        border-top: 1px solid rgba(52, 73, 110, 0.12);
      }

      .orders-nav-links.nav-open {
        display: flex;
      }

      .orders-nav-links a {
        width: auto;
        justify-content: center;
        min-height: 44px;
        font-size: 0.95rem;
      }

      .orders-shell {
        padding: 14px 14px 40px;
      }

      .orders-hero {
        padding: 18px 16px;
      }

      .order-card-top,
      .order-body {
        padding: 14px;
      }

      .order-footer {
        flex-direction: column;
        align-items: flex-start;
      }

      .order-card-top {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        flex-wrap: nowrap;
      }

      .order-id {
        flex-wrap: nowrap;
        min-width: 0;
      }

      .order-meta {
        flex-wrap: nowrap;
      }

      .status-pill {
        flex-shrink: 0;
      }

      .order-overview {
        grid-template-columns: 1fr;
      }

      .products-grid {
        grid-template-columns: 1fr;
      }

      .product-tile {
        align-items: flex-start;
      }

      .product-thumb {
        width: 56px;
        height: 56px;
      }
    }
  </style>
</head>
<body>
  <%
    const currentUser = typeof user !== 'undefined' ? user : null;
    const orderCount = orders ? orders.length : 0;
    const activeOrderCount = orders ? orders.filter(order => order.status !== 'Cancelled' && order.status !== 'Delivered').length : 0;
    const cancelledCount = orders ? orders.filter(order => order.status === 'Cancelled').length : 0;
  %>

  <div class="orders-nav-wrap">
    <header class="orders-nav">
      <h2 class="orders-brand">Seller Orders</h2>

      <button
        class="orders-menu-toggle"
        type="button"
        aria-label="Toggle navigation"
        aria-expanded="false"
        onclick="toggleOrdersMenu()"
      >
        ☰
      </button>

      <nav class="orders-nav-links" id="ordersNavLinks" aria-label="Seller orders navigation">
        <a href="/">Home</a>
        <a href="/products">Products</a>
        <a href="/products/add">Add Product</a>
        <a href="/seller/orders">Orders</a>
        <% if (currentUser) { %>
          <a href="/user/seller-profile">Profile</a>
          <a href="/auth/logout">Logout</a>
        <% } %>
      </nav>
    </header>
  </div>

  <main class="orders-shell">
    <section class="orders-hero">
      <h1>Manage customer orders </h1>
        <p class="hero-copy">Keep track of your incoming orders, update their status, and stay on top of your sales with ease.</p>

      <div class="hero-stats">
        <article class="stat-card">
          <p class="stat-label">Total Orders</p>
          <p class="stat-value"><%= orderCount %></p>
        </article>
        <article class="stat-card">
          <p class="stat-label">Active Orders</p>
          <p class="stat-value"><%= activeOrderCount %></p>
        </article>
        <article class="stat-card">
          <p class="stat-label">Cancelled</p>
          <p class="stat-value"><%= cancelledCount %></p>
        </article>
      </div>
    </section>

    <% if (orders && orders.length > 0) { %>
      <section class="orders-grid">
        <% orders.forEach(order => { %>
          <%
            const statusName = (order.status || 'Unknown').toLowerCase();
            const statusClass =
              statusName === 'placed' ? 'status-placed' :
              statusName === 'pending' ? 'status-pending' :
              statusName === 'shipped' ? 'status-shipped' :
              statusName === 'delivered' ? 'status-delivered' :
              statusName === 'cancelled' ? 'status-cancelled' :
              'status-default';
            const itemCount = order.items ? order.items.reduce((count, item) => count + (item.quantity || 0), 0) : 0;
          %>

          <article class="order-card">
            <div class="order-card-top">
              <div>
                <p class="order-label">Order Reference</p>
                <div class="order-id">
                  <span class="order-id-text"><%= order._id %></span>
                  <div class="order-meta">
                    <span class="meta-chip"><%= itemCount %> item<%= itemCount === 1 ? '' : 's' %></span>
                  </div>
                </div>
              </div>

              <span class="status-pill <%= statusClass %>"><%= order.status %></span>
            </div>

            <div class="order-body">
              <div class="order-overview">
                <div class="products-grid">
                  <% order.items.forEach(item => { %>
                    <% if (item.productId) { %>
                      <div class="product-tile">
                        <% if (item.productId.image) { %>
                          <img
                            class="product-thumb"
                            src="<%= item.productId.image %>"
                            alt="<%= item.productId.title %>"
                          >
                        <% } %>
                        <div class="product-copy">
                          <h3 class="product-title"><%= item.productId.title %></h3>
                          <div class="product-meta">
                            <p>Quantity: <strong><%= item.quantity %></strong></p>
                            <% if (item.productId.price) { %>
                              <p>Per item: <strong>&#8377;<%= item.productId.price %></strong></p>
                            <% } %>
                          </div>
                        </div>
                      </div>
                    <% } else { %>
                      <div class="product-tile">
                        <div class="product-copy">
                          <h3 class="product-title">Product unavailable</h3>
                          <p>This product information is no longer available for this order.</p>
                        </div>
                      </div>
                    <% } %>
                  <% }); %>
                </div>

                <div class="buyer-card">
                  <h3>Buyer</h3>
                  <p><strong>Name:</strong> <%= order.buyerId ? order.buyerId.name : "Unknown Buyer" %></p>
                  <% if (order.buyerId && order.buyerId.email) { %>
                    <p><strong>Email:</strong> <%= order.buyerId.email %></p>
                  <% } %>
                </div>
              </div>

              <div class="order-footer">
                <div class="action-buttons">
                  <a href="/seller/orders/<%= order._id %>" class="action-btn action-btn-primary">View Details</a>
                </div>

                <div class="seller-actions">
                  <form action="/seller/orders/<%= order._id %>/status" method="POST">
                    <select name="status">
                      <option value="Placed" <%= order.status === 'Placed' ? 'selected' : '' %>>Placed</option>
                      <option value="Shipped" <%= order.status === 'Shipped' ? 'selected' : '' %>>Shipped</option>
                      <option value="Delivered" <%= order.status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                      <option value="Cancelled" <%= order.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                    </select>
                    <button type="submit">Update Status</button>
                  </form>
                </div>
              </div>
            </div>
          </article>
        <% }); %>
      </section>
    <% } else { %>
      <section class="empty-state">
        <h2>No orders yet</h2>
        <p>Incoming buyer orders will appear here with the same card-based layout.</p>
      </section>
    <% } %>
  </main>

  <script>
    function toggleOrdersMenu() {
      const nav = document.getElementById("ordersNavLinks");
      const button = document.querySelector(".orders-menu-toggle");

      if (!nav || !button) return;

      nav.classList.toggle("nav-open");
      button.setAttribute(
        "aria-expanded",
        nav.classList.contains("nav-open") ? "true" : "false"
      );
    }
  </script>
</body>
</html>
