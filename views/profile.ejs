<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile - Handmade Treasures</title>
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    :root {
      --ink: #34496e;
      --ink-soft: #7895b2;
      --body-text: #2d3436;
      --surface: #ffffff;
      --surface-soft: #f8f4f7;
      --surface-blue: #eef5fb;
      --surface-peach: #f8ede8;
      --surface-mint: #edf6f0;
      --accent: #3aa8c1;
      --line: rgba(52, 73, 110, 0.12);
      --shadow: 0 14px 30px rgba(52, 73, 110, 0.12);
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      margin: 0;
      color: var(--body-text);
      background: linear-gradient(180deg, #fffdfc 0%, #f7f6f9 100%);
    }

    .profile-nav-wrap {
      padding: 0;
    }

    .profile-nav {
      width: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      background: var(--surface);
      border: 1px solid rgba(52, 73, 110, 0.08);
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
      position: relative;
    }

    .profile-brand {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      color: var(--ink);
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    .profile-menu-toggle {
      display: none;
      background: #34496e;
      color: #fff;
      padding: 10px 14px;
      border-radius: 10px;
      font-size: 20px;
      line-height: 1;
      border: none;
      cursor: pointer;
    }

    .profile-menu-toggle:hover,
    .profile-menu-toggle:focus {
      background: #3aa8c1;
      box-shadow: none;
      transform: none;
    }

    .profile-nav-links {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .profile-nav-links a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 40px;
      padding: 0 16px;
      border-radius: 999px;
      color: var(--ink);
      font-size: 0.95rem;
      font-weight: 600;
      transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
    }

    .profile-nav-links a:hover {
      background: rgba(52, 73, 110, 0.08);
      transform: translateY(-1px);
      color: var(--ink);
    }

    @media (max-width: 900px) {
      .profile-nav {
        padding: 12px 20px;
      }

      .profile-brand {
        font-size: 1.15rem;
      }

      .profile-nav-links {
        gap: 8px;
      }

      .profile-nav-links a {
        font-size: 0.88rem;
        padding: 0 14px;
      }
    }

    .profile-shell {
      max-width: 1200px;
      margin: 0 auto;
      padding: 18px 20px 56px;
    }

    .profile-hero {
      margin-top: 12px;
      padding: 24px;
      border: 1px solid rgba(52, 73, 110, 0.08);
      border-radius: 24px;
      background:
        linear-gradient(135deg, rgba(248, 237, 232, 0.92), rgba(238, 245, 251, 0.95)),
        linear-gradient(180deg, #fff, #fff);
      box-shadow: var(--shadow);
    }

    .profile-hero h1 {
      margin: 0 0 10px;
      text-align: left;
      font-size: clamp(1.8rem, 3.4vw, 2.8rem);
      line-height: 1.12;
      color: var(--ink);
    }

    .hero-copy {
      max-width: 720px;
      margin: 0;
      font-size: 0.98rem;
      line-height: 1.6;
      color: var(--body-text);
    }

    .profile-layout {
      display: grid;
      grid-template-columns: minmax(280px, 0.9fr) minmax(0, 1.4fr);
      gap: 18px;
      margin-top: 18px;
    }

    .profile-card {
      border: 1px solid rgba(52, 73, 110, 0.08);
      border-radius: 18px;
      background: var(--surface);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .profile-card.soft-art {
      background:
        radial-gradient(circle at top right, rgba(58, 168, 193, 0.1), transparent 32%),
        radial-gradient(circle at bottom left, rgba(248, 237, 232, 0.9), transparent 38%),
        linear-gradient(180deg, #fffdfd 0%, #fff 100%);
    }

    .card-head {
      padding: 16px 18px 14px;
      background: var(--surface-blue);
      border-bottom: 1px solid var(--line);
    }

    .card-head h2 {
      margin: 0;
      text-align: left;
      font-size: 1rem;
      color: var(--ink);
    }

    .card-body {
      padding: 18px;
    }

    .profile-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 78px;
      height: 78px;
      border-radius: 24px;
      background: linear-gradient(135deg, var(--surface-peach), var(--surface-blue));
      color: var(--ink);
      font-size: 1.8rem;
      font-weight: 700;
      box-shadow: inset 0 0 0 1px rgba(52, 73, 110, 0.06);
    }

    .profile-name {
      margin: 16px 0 6px;
      font-size: 1.25rem;
      color: var(--ink);
    }

    .profile-email {
      margin: 0;
      color: var(--ink-soft);
      line-height: 1.5;
    }

    .profile-note {
      margin: 16px 0 0;
      padding: 12px 14px;
      border-radius: 12px;
      background: var(--surface-mint);
      color: var(--body-text);
      line-height: 1.55;
      font-size: 0.92rem;
    }

    .profile-form {
      display: grid;
      gap: 14px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .field-group {
      display: grid;
      gap: 6px;
    }

    .field-group.full {
      grid-column: 1 / -1;
    }

    .field-group label {
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--ink);
    }

    .field-group input,
    .field-group textarea {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid rgba(52, 73, 110, 0.16);
      border-radius: 10px;
      font: inherit;
      color: var(--body-text);
      background: #fff;
    }

    .field-group textarea {
      min-height: 120px;
      resize: vertical;
    }

    .form-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
    }

    .save-btn,
    .secondary-link {
      min-height: 40px;
      padding: 0 16px;
      border: none;
      border-radius: 5px;
      font-size: 0.9rem;
      font-weight: 700;
    }

    .save-btn {
      background: var(--ink);
      color: #fff;
      cursor: pointer;
    }

    .save-btn:hover {
      background: var(--accent);
    }

    .secondary-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--surface-blue);
      color: var(--ink);
      text-decoration: none;
    }

    .secondary-link:hover {
      background: #dcecf8;
      color: var(--ink);
    }

    @media (max-width: 768px) {
      .profile-nav-wrap {
        padding: 14px 14px 0;
      }

      .profile-nav {
        padding: 14px 18px;
        align-items: center;
        flex-wrap: wrap;
      }

      .profile-brand {
        z-index: 2;
      }

      .profile-menu-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .profile-nav-links {
        display: none;
        width: 100%;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 14px;
        padding-top: 14px;
        border-top: 1px solid rgba(52, 73, 110, 0.12);
      }

      .profile-nav-links.nav-open {
        display: flex;
      }

      .profile-nav-links a {
        width: auto;
        justify-content: center;
        min-height: 44px;
        font-size: 0.95rem;
      }

      .profile-shell {
        padding: 14px 14px 40px;
      }

      .profile-layout,
      .form-grid {
        grid-template-columns: 1fr;
      }

      .profile-hero,
      .card-body,
      .card-head {
        padding-left: 14px;
        padding-right: 14px;
      }
    }
  </style>
</head>
<body>
  <div class="profile-nav-wrap">
    <header class="profile-nav">
      <h1 class="profile-brand">Profile</h1>

      <button
        class="profile-menu-toggle"
        type="button"
        aria-label="Toggle navigation"
        aria-expanded="false"
        onclick="toggleProfileMenu()"
      >
        ☰
      </button>

      <nav class="profile-nav-links" id="profileNavLinks" aria-label="Profile page navigation">
        <a href="/">Home</a>
        <a href="/products">Products</a>
        <a href="/cart">Cart</a>
        <a href="/orders">Orders</a>
        <a href="/user/profile">Profile</a>
        <a href="/auth/logout">Logout</a>
      </nav>
    </header>
  </div>

  <main class="profile-shell">
    <section class="profile-hero">
      <h1>Your account, in a softer handcrafted style.</h1>
      <p class="hero-copy">
        Update your buyer details here so checkout, shipping, and future orders stay smooth and accurate.
      </p>
    </section>

    <section class="profile-layout">
      <article class="profile-card soft-art">
        <div class="card-body">
          <div class="profile-badge">
            <%= (user.name || "U").trim().charAt(0).toUpperCase() %>
          </div>
          <p class="profile-email"><%= user.email %></p>
          <p class="profile-note">
            Keep your address and contact details current so your handmade treasures reach you without delays.
          </p>
        </div>
      </article>

      <article class="profile-card">
        <div class="card-head">
          <h2>Update Profile</h2>
        </div>
        <div class="card-body">
          <form class="profile-form" action="/user/profile" method="POST">
            <div class="form-grid">
              <div class="field-group">
                <label for="name">Name</label>
                <input type="text" id="name" name="name" value="<%= user.name %>" required>
              </div>

              <div class="field-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" value="<%= user.email %>" required>
              </div>

              <div class="field-group full">
                <label for="address">Address</label>
                <textarea id="address" name="address"><%= user.address || '' %></textarea>
              </div>

              <div class="field-group">
                <label for="contact">Contact Number</label>
                <input type="text" id="contact" name="contact" value="<%= user.contact || '' %>">
              </div>
            </div>

            <div class="form-actions">
              <button type="submit" class="save-btn">Save Changes</button>
              <a href="/products" class="secondary-link">Browse Products</a>
            </div>
          </form>
        </div>
      </article>
    </section>
  </main>

  <script>
    function toggleProfileMenu() {
      const nav = document.getElementById("profileNavLinks");
      const button = document.querySelector(".profile-menu-toggle");

      if (!nav || !button) return;

      nav.classList.toggle("nav-open");
      button.setAttribute(
        "aria-expanded",
        nav.classList.contains("nav-open") ? "true" : "false"
      );
    }
  </script>
</body>
</html>
