<!DOCTYPE html>
<html lang="en">
<head>
  <title>Cart</title>
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f4f4;
      margin: 0;
      padding: 0;
      color: #333;
    }
    h1 {
      text-align: center;
      margin-top: 20px;
    }
    .container {
      width: 60%;
      margin: 20px auto;
      background: #fff;
      padding: 20px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      border-radius: 8px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 20px 0;
    }
    th, td {
      text-align: left;
      padding: 10px;
      border-bottom: 1px solid #ddd;
    }
    th {
      background-color: #007bff;
      color: white;
    }
    td img {
      width: 85px;
      height: 76px;
      object-fit: cover;
      margin-right: 10px;
      border-radius: 5px;
    }
    .cart-product {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .summary {
      text-align: right;
      font-size: 1.2em;
      margin-top: 10px;
    }
    .form-container {
      margin-top: 20px;
    }
    .form-container label {
      display: block;
      margin: 10px 0 5px;
      font-weight: bold;
    }
    .form-container textarea, 
    .form-container input {
      width: 100%;
      padding: 8px;
      border: 1px solid #ddd;
      border-radius: 4px;
    }
    .form-container button {
      margin-top: 20px;
      padding: 10px 15px;
      background-color: #007bff;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
    }
    .form-container button:hover {
      background-color: #0056b3;
    }
    .empty-cart {
      text-align: center;
      padding: 20px;
      color: #666;
    }
    .continue-shopping {
      display: block;
      text-align: center;
      margin-top: 20px;
      text-decoration: none;
      color: #007bff;
      font-weight: bold;
    }
    .continue-shopping:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <h1>Your Cart</h1>
  <div class="container">
    <% if (cart && cart.items.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Price</th>
            <th>Total</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% cart.items.forEach(item => { %>
            <tr>
              <td>
                <div class="cart-product">
                  <img src="<%= item.productId.image %>" alt="<%= item.productId.title %>">
                  <%= item.productId.title %>
                </div>
              </td>
              <td><%= item.quantity %></td>
              <td>$<%= item.productId.price %></td>
              <td>$<%= item.quantity * item.productId.price %></td>
              <td>
                <form action="/cart/remove" method="POST">
                  <input type="hidden" name="productId" value="<%= item.productId._id %>" />
                  <button type="submit" style="background-color: #ff4d4d; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer;">Remove</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>

      <div class="summary">
        <p>Total: $<%= cart.items.reduce((total, item) => total + item.quantity * item.productId.price, 0) %></p>
      </div>

      <div class="form-container">
        <h3>Shipping Details</h3>
        <form action="/orders/create" method="POST">
          <label for="address">Address:</label>
          <textarea id="address" name="address" required></textarea>

          <label for="contact">Contact Number:</label>
          <input type="text" id="contact" name="contact" pattern="[0-9]{10}" required />

          <button type="submit">Place Order</button>
        </form>
      </div>
    <% } else { %>
      <div class="empty-cart">
        <p>Your cart is empty.</p>
        <a href="/products" class="continue-shopping">Continue Shopping</a>
      </div>
    <% } %>
  </div>
</body>
</html>


