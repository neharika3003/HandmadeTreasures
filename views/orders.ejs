<!DOCTYPE html>
<html lang="en">
<head>
  <title>Order History</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <h1>Your Order History</h1>

  <% if (orders.length > 0) { %>
    <table>
      <thead>
        <tr>
          <th>Order ID</th>
          <th>Products</th>
          <th>Total</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(order => { %>
          <tr>
            <td><%= order._id %></td>
            <td>
              <% order.items.forEach(item => { %>
                <p><%= item.productId.title %> - <%= item.quantity %></p>
              <% }); %>
            </td>
            <td>$<%= order.totalAmount %></td>
            <td><%= order.status %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } else { %>
    <p>You have no orders yet.</p>
  <% } %>

  <a href="/products">Continue Shopping</a>
</body>
</html>
