<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home - Handmade Treasures</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>

  <%- include("partials/header", { user: user, pageTitle: "Home" }) %>
  <div class="hero">
    <img
      src="https://curly-silver-uoejlecf04.edgeone.app/still-life-vase-with-artificial-flowers-living-room.jpg"
      alt="homepage img"
      class="home-banner"
    >

    <!-- Overlay Content -->
    <div class="hero-content">
      <h2>Welcome to Handmade Treasures</h2>
      <p>Your one-stop platform to buy and sell unique handmade products.</p>
      <a class="home-btn" href="/products">Start Exploring</a>
    </div>
  </div>

  <section id="top-picks">
    <h2>Top Picks of the Hour</h2>
    <div class="top-pick-items">
      <% topPicks.forEach(item => { %>
        <div class="top-pick">
          <img src="<%= item.image %>" alt="<%= item.title %>" class="top-pick-img">
          <h3><%= item.title %></h3>
          <p><%= item.description %></p>
          <a href="/products/product/<%= item._id %>" class="btn">View Product</a>
        </div>
      <% }); %>
    </div>
  </section>

  <footer>
    <p>&copy; 2024 Handmade Treasures. All Rights Reserved.</p>
  </footer>

  <% if (authModal) { %>
    <%- include("partials/auth-modal", { authModal: authModal }) %>
  <% } %>

</body>
</html>