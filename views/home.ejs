<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home - Handmade Treasures</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <header>
    <h1>Handmade Treasures</h1>
    <nav>
      <a href="/products">Browse Products</a>
      <!-- Conditional rendering for Seller Profile link -->

      <% if (user && user.role==='buyer') { %> 
        <!-- Show profile and logout if user is logged in -->
        <a href="/user/profile" class="btn">Profile</a>
        <a href="/auth/logout" class="btn">Logout</a>
      <%} else if (user && user.role === 'seller') { %>
        <a href="/user/seller-profile">Seller Profile</a>
        <a href="/seller/orders" class="btn">View Orders</a> <!-- Link to seller's orders -->
        <a href="/auth/logout" class="btn">Logout</a>
      <% } else { %>
        <!-- Show signup if user is not logged in -->
        <a href="/auth/signup" class="btn">Signup</a>
        <a href="/auth/login" class="btn">Login</a>
      <% } %>
    </nav>
  </header>
  
  <div class="container">
    <h2>Welcome to Handmade Treasures</h2>
    <p>Your one-stop platform to buy and sell unique handmade products.</p>
    <img src="https://i.ytimg.com/vi/6931zNLdpA0/hq720.jpg?sqp=-oaymwEhCK4FEIIDSFryq4qpAxMIARUAAAAAGAElAADIQj0AgKJD&rs=AOn4CLByl5a0cL5HsKuBkhxZDbPz5yO5iA" alt="homepage img" style="width: 90vw;height: 70vh;">
    <a class="home-btn" href="/products">Start Exploring</a>
  </div>

  <section id="top-picks">
    <h2>Top Picks of the Hour</h2>
    <div class="top-pick-items">
      <% topPicks.forEach(item => { %>
        <div class="top-pick">
          <img src="<%= item.image %>" alt="<%= item.title %>" class="top-pick-img">
          <h3><%= item.title %></h3>
          <p><%= item.description %></p>
          <a href="/products/product/<%= item._id %>" class="btn">View Product</a>
        </div>
      <% }); %>
    </div>
  </section>

  <footer>
    <p>&copy; 2024 Handmade Treasures. All Rights Reserved.</p>
  </footer>
</body>
</html>



